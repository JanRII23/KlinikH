@model KlinikH.Application.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "User Login";
}

@section Styles {
        <link rel="stylesheet" href="~/css/User/password.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/User/password.js" asp-append-version="true"></script>
}

<h1>User Login</h1>

<hr />
<div class="row">
    <div class="col-md-12">
        <form asp-action="Login">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Username" class="control-label"></label>
                <input asp-for="Username" class="form-control" />
                <span asp-validation-for="Username" class="text-danger"></span>
            </div>
            <div class="form-group" id="passwordGroup">
                <label asp-for="Password" class="control-label"></label>
                <span class="input-group-text">
                    <i id="revealPassword" class="bi bi-eye"></i>
                    <input asp-for="Password" class="form-control" id="passwordInput" />
                </span>
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
            <div class="form-group">
                <div class="checkbox">
                    <label asp-for="RememberMe">
                        <input asp-for="RememberMe" />
                        @Html.DisplayNameFor(m => m.RememberMe)
                    </label>
                </div>
            </div>
            <input type="hidden" name="returnUrl" value="@(ViewData["ReturnUrl"] ?? "/")" />
            <div class="form-group">
                <input type="submit" value="Login" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <span>Don't have an account yet? </span><a asp-area="User" asp-controller="Account" asp-action="Register">Register</a>
</div>

<div>
    <a asp-action="Index">Back to Home</a>
</div>