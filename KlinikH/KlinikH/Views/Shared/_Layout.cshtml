@using KlinikH.Domain.Entities
@inject SignInManager<AppUser> signInManager;

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - KlinikH</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
   @*  <link rel="stylesheet" href="~/_Layout.cshtml.css" /> *@
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />

    @* //TODO: fix this later just focus on the functionality for now *@
    @RenderSection("Styles", required: false)
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-danger border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse row w-100 text-center">
                    <div class="col">
                        @* TRUST, transparency, openness, accountability -> later on this is going to be a mission statement *@
                        <ul class="navbar-nav d-flex justify-content-center align-items-center">
                            <li class="nav-item" id="landing_menu_nav">
                                <select class="form-select bg-danger text-white fw-bold border-0" autocomplete="off">
                                    <option value="-1">Provider</option>
                                    <option value="1">Facility</option>
                                    <option value="2">Insurance</option>
                                </select>
                            </li>
                            <li class="nav-item" id="landing_menu_nav">
                                <form asp-action="Index" method="get">
                                    <input type="text" name="searchTerm" class="form-controlead rounded-pill ps-3 border border-white" placeholder="Search" />
                                </form>
                            </li>
                            <li class="nav-item d-flex align-items-center fw-bold" id="landing_menu_nav">
                                @@ <a class="nav-link fw-bold text-white" asp-area="User" asp-controller="Account" asp-action="Register">St. Lukes Hospital</a>
                            </li>
                        </ul>
                    </div>

                    <div class="col">
                        <ul class="navbar-nav d-flex justify-content-center">
                            <li class="nav-item" id="landing_menu_nav_main">
                                <a class="navbar-brand fw-bold fs-3 text-white display-6 text-custom-outline" asp-area="" asp-controller="Home" asp-action="Index"><span class="text-dark fs-1">K</span>linik<span class="text-dark">[</span>H+<span class="text-dark">]</span></a>
                            </li>
                        </ul>
                    </div>

                    <div class="col">
                        <ul class="navbar-nav d-flex justify-content-center">
                            <li class="nav-item d-flex align-items-center fw-bold" id="landing_menu_nav">
                                <a class="nav-link fw-bold text-black rounded-pill bg-white" asp-area="User" asp-controller="HelpHome" asp-action="Index">Help</a>
                            </li>
                            <partial name="_LoginPartial" />
                        </ul>
                    </div>
                </div>

                <div class="d-sm-inline-flex justify-content-center">
                    <ul class="navbar-nav">
                        <li class="nav-item" id="landing_menu_nav_mobile"  style="display:none;">
                            <a class="nav-link text-dark display-6" asp-area="" asp-controller="Home" asp-action="Index">Klinik[H]</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

     <div class="container">
        <main role="main" class="pb-3">
              @RenderBody()
         </main>
     </div>

    <footer class="border-top footer text-muted bg-danger">
        <div class="container text-center text-white fw-bold">
            <span class="text-dark">|</span> &copy; 2025 - <span class="text-dark fs-5">K</span>linik<span class="text-dark">[</span>H+<span class="text-dark">]</span> <span class="text-dark">|</span> <a class="text-white fw-bold text-decoration-none" asp-area=" " asp-controller="Home" asp-action="Privacy">Privacy</a> <span class="text-dark">|</span> <a class="text-white fw-bold text-decoration-none" asp-area="User" asp-controller="FAQHome" asp-action="Index">FAQ</a> <span class="text-dark">|</span> <a class="text-white fw-bold text-decoration-none" asp-area="User" asp-controller="ContactHome" asp-action="Index">Contact</a> <span class="text-dark">|</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/lib/jquery-ajax-unobtrusive/jquery.unobtrusive-ajax.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
